{"product":{"id":9879915102514,"title":"Humdinger Coffee Pods","body_html":"\u003cp dir=\"ltr\"\u003e\u003cspan\u003eOur new low waste 100 pack... perfect for the office lunch room!\u003c\/span\u003e\u003c\/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cspan\u003eHark Coffee’s 100% plant based \u003c\/span\u003e\u003cspan\u003eNespresso® compatible\u003c\/span\u003e\u003cspan\u003e pods, when you’re done, chuck them in your green bin! \u003c\/span\u003e\u003cbr\u003e\u003c\/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cspan\u003ePacked full of our blend \"Humdinger\" is definitely one of our most popular blends containing Peru, Colombia and Brazil origin beans.\u003c\/span\u003e\u003c\/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cspan\u003eSmooth, dark and rich. Perfect to cut through milk or enjoy as a refined black coffee. For a more intense coffee just run less water through your machine … or even use two (or four!)\u003c\/span\u003e\u003c\/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cspan\u003eNotes: Hazelnut, chocolate.\u003c\/span\u003e\u003c\/p\u003e","vendor":"Hark Coffee","product_type":"","created_at":"2025-06-11T05:09:06+09:30","handle":"humdinger-coffee-pods","updated_at":"2026-08-31T16:47:38+09:30","published_at":"2025-06-11T05:09:06+09:30","template_suffix":"","published_scope":"global","tags":"batch brew, chemex, coffee, filter, light, single origin, v60","variants":[{"id":50110449254706,"product_id":9879915102514,"title":"100pc","price":"95.00","sku":null,"position":1,"compare_at_price":"","fulfillment_service":"manual","inventory_management":null,"option1":"100pc","option2":null,"option3":null,"created_at":"2025-06-11T05:11:24+09:30","updated_at":"2026-08-31T16:47:38+09:30","taxable":true,"barcode":null,"grams":0,"image_id":null,"weight":0.0,"weight_unit":"kg","requires_shipping":true,"quantity_rule":{"min":1,"max":null,"increment":1},"price_currency":"AUD","compare_at_price_currency":"","quantity_price_breaks":[]}],"options":[{"id":12368852418866,"product_id":98799151025